# ---------------------------------------------------------------------------
# SRJ website repo, ignore rules
#
# Principle: this repo tracks OUR code only. WordPress core, third-party
# plugins, and uploaded media are not ours to version, and secrets are never
# committed at all.
# ---------------------------------------------------------------------------

# WordPress core
/wp-admin/
/wp-includes/
/index.php
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html

# Secrets and environment. Never commit.
# The catch-all glob is deliberate: this tree also contains
# source-wp-config.php, which carries live database credentials and would
# NOT be matched by an exact "wp-config.php" rule.
*wp-config*.php
wp-config.php
wp-config-local.php
*.env
.env*
*credentials*
*secret*
*.pem
*.key

# Host-owned files at web root
/.sucuriquarantine/
/plat-cron.php

# Uploads and generated media
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/backup*/
/wp-content/w3tc-config/

# Third-party plugins. Managed through the WP admin, not this repo.
/wp-content/plugins/

# Parent theme and any other theme. Kadence is updated through WP admin.
/wp-content/themes/*
!/wp-content/themes/srj-consulting/

# Host and dropin plugins we do not own
/wp-content/mu-plugins/gd-system-plugin/
/wp-content/mu-plugins/gd-system-plugin.php
/wp-content/mu-plugins/object-cache-pro/
/wp-content/mu-plugins/object-cache-pro.php
/wp-content/mu-plugins/vendor/
/wp-content/object-cache.php
/wp-content/advanced-cache.php
/wp-content/db.php

# Browser download artifacts. These caused a production outage on
# July 20 2026 when "ai-governance-config (1).php" was uploaded as the
# live config. They must never enter the repo or reach the server.
*(1)*
*(2)*
*(3)*
*.old
*.bak
*.sav
*.pre-migration.bak
*.orig
*.rej

# OS and editor noise
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*
*.swp
*~
.vscode/
.idea/

# Local tooling
/node_modules/
/.deploy-cache/
deploy.local.ps1
